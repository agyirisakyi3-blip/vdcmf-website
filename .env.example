# Database - Neon PostgreSQL
# Create a free database at https://neon.tech
# Replace with your actual connection string
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# NextAuth - required for admin login
# Generate a secure secret: openssl rand -hex 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-random-secret-in-production"

# App
NEXT_PUBLIC_SITE_URL="https://www.vdcmf.org"
NEXT_PUBLIC_SITE_NAME="Vision De Melbee Care Foundation"

# Paystack - for online donations
# Get keys at https://dashboard.paystack.com
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxx"
